# Back4App / Parse — cấu hình cho BẢN BUILD APP.
# Back4App → App Settings → Security & Keys.
#
#   cp .env.example .env     rồi điền giá trị thật
#   flutter run   --dart-define-from-file=.env
#   flutter build windows --dart-define-from-file=.env
#
# App ID và Client Key được nhúng vào bản build (không phải bí mật).
# REST API Key KHÔNG nằm ở đây — xem .env.server.example.
# Để nguyên giá trị YOUR_* thì app chạy hoàn toàn cục bộ, không gọi mạng.
PARSE_APP_ID=YOUR_APP_ID
PARSE_CLIENT_KEY=YOUR_CLIENT_KEY
PARSE_SERVER_URL=https://parseapi.back4app.com

# Mã đồng bộ: các thiết bị build với cùng giá trị này sẽ thấy dữ liệu của nhau.
# Tạm thay cho tài khoản cho tới khi có đăng nhập.
PARSE_SPACE=default

# Đặt 0 để tắt tự động đồng bộ (vẫn bấm nút đồng bộ tay được).
PARSE_AUTO_SYNC=1

# Khoá chỉ dùng phía máy chủ — cho script, seed dữ liệu, gọi Parse bằng curl.
#
#   cp .env.server.example .env.server
#
# TUYỆT ĐỐI không nạp file này bằng --dart-define-from-file: mọi biến trong file
# đó đi vào lệnh build của app. REST API Key có toàn quyền trên dữ liệu.
PARSE_REST_API_KEY=YOUR_REST_API_KEY

# Master Key còn mạnh hơn nữa; chỉ điền khi thật sự cần cho script quản trị.
PARSE_MASTER_KEY=YOUR_MASTER_KEY
